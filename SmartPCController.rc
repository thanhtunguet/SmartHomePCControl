#include "resource.h"
#include <winres.h>

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 286, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Smart PC Controller Settings"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Smart PC Controller",IDC_STATIC,14,12,150,10
    LTEXT           "Network shutdown listener",IDC_STATIC,14,27,150,8
    GROUPBOX        "Listener",IDC_STATIC,14,46,258,76
    LTEXT           "Port",IDC_STATIC,27,65,74,8
    EDITTEXT        IDC_PORT_EDIT,108,61,144,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Shutdown message",IDC_STATIC,27,89,74,8
    EDITTEXT        IDC_COMMAND_EDIT,108,85,144,14,ES_AUTOHSCROLL
    AUTOCHECKBOX    "Run at startup",IDC_STARTUP_CHECK,108,108,85,10
    DEFPUSHBUTTON   "Save",IDOK,166,142,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,222,142,50,14
END
